---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Page not found — oh-my-md"
  description="The requested oh-my-md page could not be found."
  lang="en"
  noindex
>
  <section class="content-page section not-found-page">
    <div class="container content-column">
      <span class="eyebrow">404 · Not found</span>
      <h1>That page is not here.</h1>
      <p class="lede">The link may be outdated, or the page may have moved.</p>
      <p><a class="button" href="/">Return to oh-my-md</a> <a href="/zh/">中文首页</a></p>
    </div>
  </section>
</SiteLayout>
