---
import ContentPage from '../../components/ContentPage.astro';
import DownloadCard from '../../components/DownloadCard.astro';
import InstallCommand from '../../components/InstallCommand.astro';
import { currentRelease, releaseDisplay, releasePackagesByPlatform } from '../../data/releases';
import { siteUrls } from '../../data/site';

const mac = releasePackagesByPlatform.macOS[0];
const windows = releasePackagesByPlatform.Windows;
const linux = releasePackagesByPlatform.Linux;
const display = releaseDisplay;
const version = currentRelease.version;
const commandCopy = {
  label: display.copyCommand.zh,
  copied: display.copiedCommand.zh,
  failed: display.copyUnavailable.zh,
};
---

<ContentPage
  title={`下载 oh-my-md ${version}`}
  description={display.downloadDescription(version).zh}
  lang="zh"
  canonicalPath="/zh/download/"
>
  <span class="eyebrow">{display.currentReleaseLabel(version).zh}</span>
  <h1>下载 oh-my-md</h1>
  <p class="lede">为你的桌面系统选择安装包。{display.authoritativeSource.zh}</p>
  <aside class="warning" aria-label={display.unsignedAriaLabel.zh}>
    <strong>{display.unsignedLabel.zh}</strong> {display.unsignedNotice(version).zh}
  </aside>

  <section class="download-section" aria-labelledby="macos-title">
    <h2 id="macos-title">macOS</h2>
    <div class="download-grid">
      <DownloadCard package={mac} lang="zh" />
    </div>
  </section>

  <section class="download-section" aria-labelledby="windows-title">
    <h2 id="windows-title">Windows</h2>
    <p>{display.windowsGuidance.zh}</p>
    <div class="download-grid">
      <DownloadCard package={windows[0]} lang="zh" />
      <DownloadCard
        package={windows[1]}
        lang="zh"
        note={display.msiNote.zh}
      />
    </div>
  </section>

  <section class="download-section" aria-labelledby="linux-title">
    <h2 id="linux-title">Linux</h2>
    <div class="download-grid">
      <DownloadCard package={linux[0]} lang="zh" />
      <DownloadCard package={linux[1]} lang="zh" />
    </div>
  </section>

  <section class="download-section" aria-labelledby="verify-title">
    <h2 id="verify-title">{display.verifyHeading.zh}</h2>
    <p>
      下载 <a href={currentRelease.checksumUrl} rel="noopener noreferrer">{display.checksumLinkLabel.zh}</a>{display.verificationInstructions.zh}
      <a href={currentRelease.releasePage} rel="noopener noreferrer">{display.releasePageLinkLabel(version).zh}</a>。
    </p>
    <div class="install-grid">
      <InstallCommand
        label={display.commandLabels.unix.zh}
        shell="bash"
        command={`shasum -a 256 <downloaded-file>`}
        copyLabel={commandCopy.label}
        copiedLabel={commandCopy.copied}
        copyFailedLabel={commandCopy.failed}
      />
      <InstallCommand
        label={display.commandLabels.windows.zh}
        shell="powershell"
        command={`Get-FileHash .\\downloaded-file -Algorithm SHA256`}
        copyLabel={commandCopy.label}
        copiedLabel={commandCopy.copied}
        copyFailedLabel={commandCopy.failed}
      />
    </div>
    <p class="muted">{display.copyOnlyNotice.zh}</p>
    <p>
      <a class="button button-secondary-light" href={siteUrls.release} rel="noopener noreferrer">
        {display.allReleases.zh}
      </a>
    </p>
  </section>
</ContentPage>
