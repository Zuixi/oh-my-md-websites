---
import ContentPage from '../../components/ContentPage.astro';
import { currentRelease, releaseDisplay } from '../../data/releases';

const description = releaseDisplay.changelogDescription(currentRelease.version).zh;
---

<ContentPage
  title="更新日志 — oh-my-md"
  description={description}
  lang="zh"
  canonicalPath="/zh/changelog/"
>
  <span class="eyebrow">更新日志</span>
  <h1>oh-my-md {currentRelease.version}</h1>
  <p class="lede">{releaseDisplay.changelogIntro(currentRelease.version, currentRelease.releasedAt).zh}</p>
  <section class="content-section">
    <h2>{currentRelease.version}</h2>
    <ul>
      {releaseDisplay.changelogFeatures.map((feature) => <li>{feature.zh}</li>)}
    </ul>
    <p>
      <a class="button" href={currentRelease.releasePage} rel="noopener noreferrer">
        {releaseDisplay.changelogReleaseLinkLabel(currentRelease.version).zh}
      </a>
    </p>
  </section>
  <p>
    关于项目背景和源码，请查看
    <a href="https://github.com/Zuixi/oh-my-md#readme" rel="noopener noreferrer">主 README</a>。
  </p>
</ContentPage>
