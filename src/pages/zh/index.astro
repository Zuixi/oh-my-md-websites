---
import FeatureSection from '../../components/FeatureSection.astro';
import Hero from '../../components/Hero.astro';
import PerformanceSection from '../../components/PerformanceSection.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { siteCopy } from '../../data/site';

const copy = siteCopy.zh;
---

<SiteLayout title={copy.title} description={copy.description} lang="zh" canonicalPath="/zh/">
  <Hero lang="zh" copy={siteCopy} />
  <TrustStrip items={copy.trust} />
  <FeatureSection id="live-preview" copy={copy.livePreview} tone="light" />
  <PerformanceSection copy={copy.performance} />
  <FeatureSection id="markdown" copy={copy.markdown} tone="tint" />
  <FeatureSection id="local-files" copy={copy.localFiles} tone="light" />
  <FeatureSection id="platform" copy={copy.platform} tone="tint" />
  <section class="section section-cta" aria-labelledby="license-title">
    <div class="container">
      <span class="eyebrow">默认开放</span>
      <h2 id="license-title">保持简单的 Markdown 编辑器。</h2>
      <p>下载当前版本，或查看源码并自行构建。采用 {copy.license} 协议。</p>
      <a class="button" href="/zh/download">选择你的平台</a>
    </div>
  </section>
</SiteLayout>
