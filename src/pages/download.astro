---
import ContentPage from '../components/ContentPage.astro';
import DownloadHero from '../components/DownloadHero.astro';
import PlatformDownloadPanel from '../components/PlatformDownloadPanel.astro';
import InstallGuidance from '../components/InstallGuidance.astro';
import DownloadVerification from '../components/DownloadVerification.astro';
import { currentRelease, releaseDisplay, releasePackagesByPlatform, type ReleasePlatform, type ReleasePackage } from '../data/releases';

const mac = releasePackagesByPlatform.macOS[0];
const windows = releasePackagesByPlatform.Windows;
const linux = releasePackagesByPlatform.Linux;
const display = releaseDisplay;
const version = currentRelease.version;

const platformPrimaries: Record<ReleasePlatform, ReleasePackage> = {
  macOS: mac,
  Windows: windows[0], // NSIS installer (recommended)
  Linux: linux[0],   // AppImage
};
---

<ContentPage
  title={`Download oh-my-md ${version}`}
  description={display.downloadDescription(version).en}
  lang="en"
  canonicalPath="/download/"
  wide={true}
>
  <DownloadHero
    release={currentRelease}
    lang="en"
    platformPrimaries={platformPrimaries}
  />

  <aside class="warning" aria-label={display.unsignedAriaLabel.en}>
    <strong>{display.unsignedLabel.en}</strong> {display.unsignedNotice(version).en}
  </aside>

  <div class="platform-panels">
    <PlatformDownloadPanel
      platform="macOS"
      primary={mac}
      lang="en"
    />
    <PlatformDownloadPanel
      platform="Windows"
      primary={windows[0]}
      secondary={windows[1]}
      lang="en"
    />
    <PlatformDownloadPanel
      platform="Linux"
      primary={linux[0]}
      secondary={linux[1]}
      lang="en"
    />
  </div>

  <InstallGuidance
    lang="en"
    packages={{
      appImage: linux[0],
      deb: linux[1],
    }}
  />

  <DownloadVerification lang="en" />
</ContentPage>
