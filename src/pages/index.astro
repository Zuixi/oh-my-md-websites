---
import CtaMid from '../components/CtaMid.astro';
import FeatureSection from '../components/FeatureSection.astro';
import Hero from '../components/Hero.astro';
import PerformanceSection from '../components/PerformanceSection.astro';
import TrustStrip from '../components/TrustStrip.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { siteCopy } from '../data/site';

const copy = siteCopy.en;
---

<SiteLayout title={copy.title} description={copy.description} lang="en" canonicalPath="/">
  <Hero lang="en" copy={siteCopy} />
  <FeatureSection id="live-preview" copy={copy.livePreview} tone="light" />
  <CtaMid lang="en" />
  <PerformanceSection copy={copy.performance} />
  <TrustStrip items={copy.trust} ariaLabel={copy.trustAriaLabel} />
  <FeatureSection id="markdown" copy={copy.markdown} tone="light" />
  <FeatureSection id="local-files" copy={copy.localFiles} tone="tint" />
  <FeatureSection id="platform" copy={copy.platform} tone="light" />
  <section class="section section-cta" aria-labelledby="license-title">
    <div class="container">
      <span class="eyebrow">{copy.cta.eyebrow}</span>
      <h2 id="license-title">{copy.cta.title}</h2>
      <p>{copy.cta.description}</p>
      <a class="button" href="/download/">{copy.cta.buttonLabel}</a>
    </div>
  </section>
</SiteLayout>
