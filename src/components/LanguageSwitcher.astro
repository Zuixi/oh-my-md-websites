---
interface Props {
  lang: 'en' | 'zh';
  alternatePath: string;
  ariaLabel: string;
}

const { lang, alternatePath, ariaLabel } = Astro.props;
const isChinese = lang === 'zh';
---

<nav class="language-switcher" aria-label={ariaLabel}>
  {isChinese ? (
    <a href={alternatePath} lang="en" hreflang="en">English</a>
  ) : (
    <a href={alternatePath} lang="zh-CN" hreflang="zh-CN">简体中文</a>
  )}
</nav>
