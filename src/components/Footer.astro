---
import { siteUrls } from '../data/site';

interface Props {
  lang: 'en' | 'zh';
}

const { lang } = Astro.props;
const isZh = lang === 'zh';

const localePrefix = isZh ? '/zh' : '';
const altHref = isZh ? '/' : '/zh/';
const altLabel = isZh ? 'English' : '简体中文';
const altLang = isZh ? 'en' : 'zh-CN';

const navItems = [
  { href: `${localePrefix}/download/`, label: isZh ? '下载' : 'Download' },
  { href: `${localePrefix}/docs/`, label: isZh ? '文档' : 'Docs' },
  { href: `${localePrefix}/support/`, label: isZh ? '支持' : 'Support' },
  { href: `${localePrefix}/changelog/`, label: isZh ? '更新日志' : 'Changelog' },
  { href: `${localePrefix}/privacy/`, label: isZh ? '隐私政策' : 'Privacy' },
  { href: siteUrls.repository, label: 'GitHub', external: true },
  { href: siteUrls.issues, label: isZh ? '反馈' : 'Issues', external: true },
  { href: siteUrls.security, label: isZh ? '安全披露' : 'Security', external: true },
];

const copyright = `© ${new Date().getFullYear()} oh-my-md contributors · Apache-2.0 License`;
const madeWith = isZh
  ? '由 Tauri 2 · Rust · CodeMirror 6 驱动'
  : 'Made with Tauri 2 · Rust · CodeMirror 6';
const langLabel = isZh ? '切换语言' : 'Switch language';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <a class="footer-brand" href={isZh ? '/zh/' : '/'}>
      <img src="/logo.png" width="28" height="28" alt="" />
      <span>oh-my-md</span>
    </a>

    <nav class="footer-nav" aria-label={isZh ? '页脚主导航' : 'Footer navigation'}>
      {navItems.map((item) => (
        <a
          href={item.href}
          rel={item.external ? 'noopener noreferrer' : undefined}
          target={item.external ? '_blank' : undefined}
        >
          {item.label}{item.external ? ' ↗' : ''}
        </a>
      ))}
    </nav>
  </div>

  <div class="container footer-bottom">
    <p class="footer-copy">{copyright}</p>
    <p class="footer-made-with">{madeWith}</p>
    <nav class="footer-lang" aria-label={langLabel}>
      <a href={altHref} lang={altLang} hreflang={altLang}>{altLabel}</a>
    </nav>
  </div>
</footer>
