---
import type { Language } from '../data/site';
import SiteLayout from '../layouts/SiteLayout.astro';

interface Props {
  title: string;
  description: string;
  lang: Language;
  canonicalPath: string;
  wide?: boolean;
}

const { title, description, lang, canonicalPath, wide = false } = Astro.props;
---

<SiteLayout title={title} description={description} lang={lang} canonicalPath={canonicalPath}>
  <section class={`section content-page ${wide ? 'content-page-wide' : ''}`}>
    <div class={`container ${wide ? 'download-layout' : 'content-column'}`}>
      <slot />
    </div>
  </section>
</SiteLayout>
